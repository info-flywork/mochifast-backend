{
  "name": "mochifast-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MochiFast API — Node.js (JavaScript, ESM) + Fastify + MySQL",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "migrate:dry": "node scripts/migrate.js --dry-run",
    "deploy": "bash scripts/deploy.sh",
    "migrate:new": "node scripts/new-migration.js",
    "openapi": "node scripts/generate-openapi.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/etag": "^6.2.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/under-pressure": "^9.2.0",
    "@sentry/node": "^11.4.0",
    "close-with-grace": "^2.5.0",
    "env-schema": "^8.0.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.5",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  }
}
