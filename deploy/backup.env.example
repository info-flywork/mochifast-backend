# Yedekleme (scripts/backup-db.sh, scripts/restore-drill.sh). Sunucuda deploy/backup.env olarak.
# Bunny → yeni storage zone (ör. mochifast-backups, DE). Pull zone BAĞLAMAYIN (internetten okunamasın).
BACKUP_STORAGE_ZONE=
BACKUP_STORAGE_PASSWORD=
BACKUP_STORAGE_HOST=storage.bunnycdn.com
# Uzun rastgele değer (openssl rand -base64 48). KAYBEDİLİRSE YEDEKLER AÇILAMAZ: parola yöneticisine koy.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30
# Tatbikat hedefi (boşsa .env'deki DB sunucusu; ayrı veritabanı adıyla)
RESTORE_DB_HOST=
RESTORE_DB_PORT=
RESTORE_DB_USER=
RESTORE_DB_PASSWORD=
