# MochiFast API — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın (`.env` git'e girmez). Üretimde değerler secret manager'dan gelir.
# Doğrulama: src/config/index.js — eksik/hatalı değerle process BAŞLAMAZ.

# ── Genel ─────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | staging | production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
APP_RELEASE=dev                 # CI'da git SHA (Sentry release)
LOG_LEVEL=debug                 # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=false               # LB/proxy arkasında: true veya hop sayısı (ör. 1)
BODY_LIMIT_BYTES=65536          # JSON gövde limiti; medya uçları kendi limitini koyar
SHUTDOWN_GRACE_MS=25000         # kapanışta açık isteklerin bitmesi için azami süre
SHUTDOWN_DRAIN_MS=0             # üretimde ~5000: readiness 503 → LB'nin fark etmesi için bekleme

# ── MySQL 8 ───────────────────────────────────────────────────────────
DB_HOST=127.0.0.1               # API ile aynı sunucudaysa localhost (SSL gerekmez)
DB_PORT=3306
DB_USER=mochifast
DB_PASSWORD=mochifast
DB_NAME=mochifast
DB_SSL=false                    # üretimde uzak (localhost olmayan) MySQL için true ZORUNLU
DB_SSL_CA=                      # yönetilen MySQL CA sertifikası (PEM), gerekirse
DB_SSL_VERIFY=true              # false: kendinden imzalı sertifika (yalnızca geliştirme; üretimde yasak)
DB_POOL_SIZE=20                 # süreç başına
DB_SLOW_QUERY_MS=200

# ── Cache & iş kuyruğu (Redis yok: docs/adr/0005-redis-yok.md) ───────
CACHE_MAX_ENTRIES=10000         # process içi LRU cache'in en fazla anahtar sayısı
WORKER_CONCURRENCY=5            # worker'ın aynı anda çalıştırdığı iş sayısı
WORKER_POLL_MS=1000             # boş kuyrukta jobs tablosuna bakma aralığı

# ── Kimlik doğrulama (F1) ─────────────────────────────────────────────
# Anahtarları yenilemek / döndürmek için: npm run keys:jwt  ·  npm run keys:field
JWT_PRIVATE_JWK=               # npm run keys:jwt çıktısı (tek satır JSON, tek tırnak içinde)
JWT_PUBLIC_JWKS=               # npm run keys:jwt çıktısı
JWT_ISSUER=api.mochifast.app
JWT_AUDIENCE=mochifast-app
JWT_ACCESS_TTL_SEC=900          # access token: 15 dk
REFRESH_TTL_DAYS=60             # refresh token: 60 gün (her yenilemede uzar)
FIELD_ENCRYPTION_KEYS_JSON=    # npm run keys:field çıktısı
FIELD_ENCRYPTION_ACTIVE_KID=1
FIREBASE_PROJECT_ID=            # EKSİK: Firebase Console → Project settings → Project ID (boşken Apple/Google girişi kapalı)
FIREBASE_SIGN_IN_PROVIDERS=apple.com,google.com   # kabul edilen Firebase giriş yöntemleri; misafir backend'de

# ── HTTP güvenlik ─────────────────────────────────────────────────────
CORS_ORIGINS=                   # yalnızca yönetim paneli, virgülle: https://admin.mochifast.app
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_WINDOW=1 minute

# ── Gözlemlenebilirlik ────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0            # /metrics ayrı portta; yalnızca iç ağdan erişilebilir olmalı
METRICS_PORT=9464
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── API belgeleri (yalnızca dev/staging) ──────────────────────────────
DOCS_ENABLED=false
DOCS_USER=
DOCS_PASSWORD=                  # en az 12 karakter

# ── Bunny CDN (F5'te okunmaya başlar) ─────────────────────────────────
BUNNY_STORAGE_ZONE=mochifast
BUNNY_STORAGE_PASSWORD=          # Storage Zone → FTP & API Access → Password
BUNNY_STORAGE_HOST=storage.bunnycdn.com   # bölgeye göre: de → storage.bunnycdn.com, uk → uk.storage.bunnycdn.com, ny, la, sg, se, br, jh, syd
BUNNY_PULL_ZONE_HOST=mochifast.b-cdn.net
BUNNY_TOKEN_AUTH_KEY=            # Pull Zone → Security → Token Authentication (özel medya için imzalı URL)
BUNNY_API_KEY=                   # Account → API key (cache purge)
MEDIA_PATH_SECRET=               # rastgele 32+ karakter; dosya yollarını tahmin edilemez yapar

# ── Sonraki fazlar (henüz okunmuyor; docs/backend/02-mimari.md §3.6) ───
# F6  ANTHROPIC_API_KEY, AI_CHAT_MODEL, AI_VISION_MODEL
# F8  REVENUECAT_SECRET_API_KEY, REVENUECAT_WEBHOOK_AUTH
# F9  FCM_SERVICE_ACCOUNT_JSON
