# MochiFast API — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın (`.env` git'e girmez). Üretimde değerler secret manager'dan gelir.
# Doğrulama: src/config/index.js — eksik/hatalı değerle process BAŞLAMAZ.

# ── Genel ─────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | staging | production
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
APP_RELEASE=dev                 # CI'da git SHA (Sentry release)
LOG_LEVEL=debug                 # fatal | error | warn | info | debug | trace | silent
TRUST_PROXY=false               # LB/proxy arkasında: true veya hop sayısı (ör. 1)
BODY_LIMIT_BYTES=65536          # JSON gövde limiti; medya uçları kendi limitini koyar
SHUTDOWN_GRACE_MS=25000         # kapanışta açık isteklerin bitmesi için azami süre
SHUTDOWN_DRAIN_MS=0             # üretimde ~5000: readiness 503 → LB'nin fark etmesi için bekleme

# ── MySQL 8 ───────────────────────────────────────────────────────────
DB_HOST=127.0.0.1               # API ile aynı sunucudaysa localhost (SSL gerekmez)
DB_PORT=3306
DB_USER=mochifast
DB_PASSWORD=mochifast
DB_NAME=mochifast
DB_SSL=false                    # üretimde uzak (localhost olmayan) MySQL için true ZORUNLU
DB_SSL_CA=                      # yönetilen MySQL CA sertifikası (PEM), gerekirse
DB_SSL_VERIFY=true              # false: kendinden imzalı sertifika (yalnızca geliştirme; üretimde yasak)
DB_POOL_SIZE=20                 # süreç başına
DB_SLOW_QUERY_MS=200

# ── Cache & iş kuyruğu (Redis yok: docs/adr/0005-redis-yok.md) ───────
CACHE_MAX_ENTRIES=10000         # process içi LRU cache'in en fazla anahtar sayısı
WORKER_CONCURRENCY=5            # worker'ın aynı anda çalıştırdığı iş sayısı
WORKER_POLL_MS=1000             # boş kuyrukta jobs tablosuna bakma aralığı

# ── Kimlik doğrulama (F1) ─────────────────────────────────────────────
# Anahtarları yenilemek / döndürmek için: npm run keys:jwt  ·  npm run keys:field
JWT_PRIVATE_JWK=               # npm run keys:jwt çıktısı (tek satır JSON, tek tırnak içinde)
JWT_PUBLIC_JWKS=               # npm run keys:jwt çıktısı
JWT_ISSUER=api.mochifast.app
JWT_AUDIENCE=mochifast-app
JWT_ACCESS_TTL_SEC=900          # access token: 15 dk
REFRESH_TTL_DAYS=60             # refresh token: 60 gün (her yenilemede uzar)
FIELD_ENCRYPTION_KEYS_JSON=    # npm run keys:field çıktısı
FIELD_ENCRYPTION_ACTIVE_KID=1
FIREBASE_PROJECT_ID=            # EKSİK: Firebase Console → Project settings → Project ID (boşken Apple/Google girişi kapalı)
FIREBASE_SIGN_IN_PROVIDERS=apple.com,google.com   # kabul edilen Firebase giriş yöntemleri; misafir backend'de

# ── HTTP güvenlik ─────────────────────────────────────────────────────
CORS_ORIGINS=                   # yalnızca yönetim paneli, virgülle: https://admin.mochifast.app
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_WINDOW=1 minute

# ── Gözlemlenebilirlik ────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0            # /metrics ayrı portta; yalnızca iç ağdan erişilebilir olmalı
METRICS_PORT=9464
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── API belgeleri (yalnızca dev/staging) ──────────────────────────────
DOCS_ENABLED=false
DOCS_USER=
DOCS_PASSWORD=                  # en az 12 karakter

# ── Medya & Bunny CDN (docs/backend/08-medya-bunny.md) ────────────────
MEDIA_DRIVER=local               # local (geliştirme: var/media + API sunar) | bunny (üretimde zorunlu)
MEDIA_LOCAL_DIR=var/media
MEDIA_PATH_SECRET=               # rastgele 32+ karakter; dosya yollarını tahmin edilemez yapar (üretimde zorunlu)
MEDIA_UPLOAD_MAX_BYTES=10485760  # 10 MB; aşınca 413
MEDIA_URL_TTL_SEC=21600          # imzalı URL süresi (6 sa; saat başına yuvarlanır)

# Public zone: uygulama görselleri + yönetim içeriği (token YOK, herkese açık)
BUNNY_STORAGE_ZONE=mochifast
BUNNY_STORAGE_PASSWORD=          # Storage Zone → FTP & API Access → Password
BUNNY_STORAGE_HOST=storage.bunnycdn.com   # bölgeye göre: de → storage.bunnycdn.com, uk → uk.storage.bunnycdn.com, ny, la, sg, se, br, jh, syd
BUNNY_PULL_ZONE_HOST=mochifast.b-cdn.net

# Private zone: kullanıcı fotoğrafları. AYRI storage zone + pull zone; pull zone'da
# Security → Token Authentication AÇIK olmalı. Public zone ile aynı olursa API başlamaz.
BUNNY_PRIVATE_STORAGE_ZONE=      # ör. mochifast-private
BUNNY_PRIVATE_STORAGE_PASSWORD=
BUNNY_PRIVATE_STORAGE_HOST=storage.bunnycdn.com
BUNNY_PRIVATE_PULL_ZONE_HOST=    # ör. mochifast-private.b-cdn.net
BUNNY_TOKEN_AUTH_KEY=            # PRIVATE pull zone → Security → Token Authentication → Url Token Authentication Key
BUNNY_API_KEY=                   # Account → API key (cache purge)

# ── Yapay zekâ (docs/backend/09-yapay-zeka.md) ─────────────────────────
# Sohbet + fotoğraf analizi OpenAI (ChatGPT) ile.
OPENAI_API_KEY=                  # platform.openai.com → API keys; yoksa AI uçları 503
OPENAI_CHAT_MODEL=               # sohbet için zorunlu (anahtarla birlikte)
OPENAI_VISION_MODEL=gpt-4o       # fotoğraf analizi (görüntü destekli model)
OPENAI_REASONING_EFFORT=         # yalnızca reasoning modellerde: minimal | low | medium | high
AI_ANALYSIS_TIMEOUT_MS=45000
AI_CHAT_MAX_OUTPUT_TOKENS=1200
AI_CHAT_FIRST_TOKEN_MS=15000     # ilk parça gelmezse iptal
AI_CHAT_TOTAL_MS=90000
AI_CHAT_QUOTA_ENABLED=true       # false: sohbet günlük kotası yok (yalnızca geliştirmede kapat)

# ── Abonelik: RevenueCat (docs/backend/11-abonelik.md) ─────────────────
# Paywall istemcide RevenueCat Paywalls ile; sunucu yalnızca premium durumunu yansıtır.
REVENUECAT_SECRET_API_KEY=       # RevenueCat → Project settings → API keys → Secret API key (sk_…; v1 REST)
REVENUECAT_WEBHOOK_AUTH=         # RevenueCat → Integrations → Webhooks → Authorization header değeri (uzun rastgele)
REVENUECAT_ENTITLEMENT=mochifast_pro   # entitlement identifier (RevenueCat panelindeki)
REVENUECAT_ALLOW_SANDBOX=        # boş: üretim dışında true, üretimde false (TestFlight'ta premium için true)

# ── Push bildirimleri (FCM HTTP v1) ──────────────────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key (JSON).
# Tek satır ham JSON ya da base64: `base64 -i key.json`. Boşsa push kapalı, inbox çalışır.
FCM_SERVICE_ACCOUNT_JSON=

# ── Sonraki fazlar (henüz okunmuyor; docs/backend/02-mimari.md §3.6) ───

# ── Yönetim paneli (F10) ──
# Panelin adresi CORS_ORIGINS'e eklenmeli (ör. https://admin.mochifast.app).
# Virgülle IP/CIDR (ör. 203.0.113.7,10.0.0.0/8). Boş = her IP (uyarı loglanır).
ADMIN_IP_ALLOWLIST=
ADMIN_TOKEN_TTL_SEC=3600

# ── F11 ──
# Worker metrikleri (/metrics, yalnızca iç ağ); API portundan farklı olmalı.
METRICS_WORKER_PORT=9465
# Üretimde ADMIN_IP_ALLOWLIST boşsa admin API kapalı; bilinçli olarak her IP'ye açmak için true.
ADMIN_ALLOW_ANY_IP=false
# Oturumun mutlak ömrü (gün): sonra yeniden giriş (misafir otomatik).
REFRESH_ABSOLUTE_DAYS=180
